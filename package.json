{
  "name": "hudui-group",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "gen:icons": "node scripts/gen-icons.js",
    "check:ai": "node scripts/check-ai.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:smoke": "node scripts/regression-all.mjs",
    "test:security": "node scripts/smoke-security.mjs",
    "build:visual": "node scripts/build-visual-bundle.mjs",
    "test:music": "node --test server/tests/music-providers.test.mjs",
    "test:listen": "node scripts/test-listen-together.mjs",
    "test:private-listen": "node scripts/test-private-listen.mjs",
    "test:invite-card": "node scripts/test-invite-card.mjs",
    "test:tower": "node --test server/tests/tower-battle.test.mjs && node scripts/test-tower-battle.mjs",
    "test:guess": "node --test server/tests/guess-song.test.mjs && node scripts/test-guess-song.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rotate-logs": "node scripts/rotate-logs.mjs",
    "media:gc": "node scripts/media-gc.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "NeteaseCloudMusicApi": "^4.32.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.4.2",
    "vite": "^6.0.7"
  }
}
